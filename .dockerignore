# Keep the build context small and secret-free. The Dockerfile copies only requirements.txt and
# qatraffic/, but these exclusions also stop secrets/state from ever entering the context.
.git
.gitignore
var/
*.env
!config.env.example
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
*.sqlite3
*.sqlite3-*
tests/
systemd/
scripts/
*.md
docs/
Dockerfile
.dockerignore
fly.toml
