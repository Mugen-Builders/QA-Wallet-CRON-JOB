# qa-traffic-bot configuration. Copy to ~/.config/qa-traffic-bot/config.env (mode 600).
# scripts/install-user-unit.sh does the copy for you. Never commit the filled-in file.
#
# Every setting is an environment variable, so this file works equally for local systemd and for
# fly.io. On fly.io the SECRETS below (marked "SECRET") go through `fly secrets set`, never in the
# image or fly.toml; the rest can live in fly.toml [env]. See docs/DEPLOY-FLY.md for the runbook.
#   SECRET: QA_TRAFFIC_ENTROPY, QA_TRAFFIC_FUNDER_KEY, QA_TRAFFIC_L1_RPC_URL(_FALLBACK),
#           QA_TRAFFIC_DISCORD_WEBHOOK_URL, and the node/sequencer URLs if they embed a token.

# ---- storage --------------------------------------------------------------------------------
# Base directory for all mutable state: the SQLite DB (state/), the heartbeat and the logs/.
# Default: <repo>/var. On fly.io set this to the mounted volume so state survives restarts
# (fly.toml sets QA_TRAFFIC_HOME=/data with a volume mounted at /data).
QA_TRAFFIC_HOME=

# ---- chain (Ethereum Sepolia) -----------------------------------------------------------------
QA_TRAFFIC_CHAIN_ID=11155111
# SECRET (usually embeds a provider API key): the L1 JSON-RPC endpoint. Required.
QA_TRAFFIC_L1_RPC_URL=
# optional second provider, used when the first one fails. SECRET. Strongly recommended -- it
# avoids the RPC stalls that trigger watchdog restarts.
QA_TRAFFIC_L1_RPC_URL_FALLBACK=

# rollups-contracts v3.0.0-alpha.10 on Sepolia (defaults; verified on-chain 2026-11-03).
# These two are address-SPECIFIC and must be exactly right -- the bot models them individually:
#   INPUT_BOX    : the single InputBox the bot reads every input from.
#   ERC20_PORTAL : the ERC-20 deposit portal for the token below. The bot fully models ERC-20
#                  deposits, so a wrong value here breaks balance tracking.
QA_TRAFFIC_INPUT_BOX=0xEbE9f4Dfc04ae10bBeE663859c3dc5A23f94eA3C
QA_TRAFFIC_ERC20_PORTAL=0x3332DE61a8BB9aC84893b2f552Fe81C9a6dC5419
# TestUsdc on Sepolia (6 decimals, anyone can mint): must be the token the app pinned at genesis
# (the deployer's config range / QA_TOKEN); the bot checks it through the app's `state` inspect
QA_TRAFFIC_TOKEN=0x0696259375E54AB38749e23ac5dc56fD10d51290
# The OTHER (non-ERC-20) deposit portals: Ether, ERC-721, ERC-1155-single and ERC-1155-batch.
# ORDER DOES NOT MATTER -- this is parsed into an unordered SET. The bot only checks whether an
# input's sender is in this set, to COUNT those deposits (it does not model them), so there is no
# per-token slot to line up and nothing to mix up: just list the four non-ERC-20 portal addresses,
# comma-separated, in any order. (ERC-20 is configured separately, above.)
QA_TRAFFIC_OTHER_PORTALS=0x035b11Be55656c6cfC822D1CaE568C1Af2e497b0,0x397c352d18DFf47CC8a6143403142cf7afd5Ff7E,0x585F56351A66f131E176a345662215C772f80451,0xee33550a22e3Cf6Cc265524dC9bcfD99D2307EBe
# The bot folds every InputBox input up to this block tag (safe | finalized | latest), like the
# sequencer reads `safe`; optional extra confirmations below it; eth_getLogs range per request
QA_TRAFFIC_L1_READ_TAG=safe
QA_TRAFFIC_L1_READ_EXTRA_CONFIRMATIONS=0
QA_TRAFFIC_LOG_CHUNK_BLOCKS=2000

# ---- the application (fill in once it is deployed; until then the bot idles) ------------------
QA_TRAFFIC_APP_ADDRESS=
# the node serving this app: JSON-RPC (…/rpc) and inspect base (…/inspect, the bot appends /<app>)
QA_TRAFFIC_NODE_RPC_URL=
QA_TRAFFIC_NODE_INSPECT_URL=
# name or address the node knows the app by (default: the app address)
QA_TRAFFIC_NODE_APP=
# the app's sequencer: the public API (POST /tx, GET /fee, /nonce, /domain)
QA_TRAFFIC_SEQUENCER_URL=
# optional: the sequencer's operator-only routes (/history, /healthz) for the checkpoint cross-check
QA_TRAFFIC_SEQUENCER_EGRESS_URL=
# optional: the batch submitter; read from the app's `state` inspect when empty, checked when set
QA_TRAFFIC_BATCH_SUBMITTER=

# ---- accounts ---------------------------------------------------------------------------------
# SECRET. 32 random bytes: python3 -m qatraffic new-entropy   (never a phrase you made up).
# Required, and must stay STABLE across restarts -- it derives the wallet set. Generate once.
QA_TRAFFIC_ENTROPY=
QA_TRAFFIC_ACCOUNT_OFFSET=0
QA_TRAFFIC_ACCOUNT_COUNT=60
# SECRET. Gas funder private key, provided by the app deployer; it only ever sends ETH for gas.
QA_TRAFFIC_FUNDER_KEY=

# ---- traffic ------------------------------------------------------------------------------------
QA_TRAFFIC_DAILY_MIN=80
QA_TRAFFIC_DAILY_MAX=120
QA_TRAFFIC_BUSY_DAY_PROB=0.07
QA_TRAFFIC_BUSY_DAY_MAX=150
QA_TRAFFIC_INVALID_RATE=0.01
# average share of transfers/withdrawals sent straight to L1 (InputBox) instead of the sequencer
QA_TRAFFIC_L1_ROUTE_SHARE=0.15
QA_TRAFFIC_OTHER_EXECUTOR_SHARE=0.1
QA_TRAFFIC_INITIAL_ACTIVE_SHARE=0.6
QA_TRAFFIC_ONBOARDING_DAYS=21
# Virtual-clock multiplier: >1 compresses the daily schedule for testing (e.g. 24 fits a day of
# traffic into an hour). KEEP AT 1.0 in production -- a higher value also shortens every timing
# budget (voucher ETAs, batch/landing deadlines) and will fire false alerts against a real chain.
QA_TRAFFIC_TIME_SCALE=1.0
# Sweep leftover wallet ETH and TUSD back to the funder on every (re)start, then re-fund
# lazily before each session. For a headless host (fly.io) with no terminal for `qatraffic sweep`
# AND no persistent disk, where each restart is a fresh instance anyway. Keep it FALSE when the
# database persists (local systemd, a mounted volume): a crash/watchdog restart would otherwise
# sweep funds back mid-session and interrupt in-flight work. Set a fallback RPC above to avoid the
# RPC stalls that cause those restarts in the first place.
QA_TRAFFIC_SWEEP_ON_START=false

# ---- sequencer ----------------------------------------------------------------------------------
# a soft-confirmed user op must be executed on L1 within this (the sequencer's default batch
# window is 2 h); no batch for this long while work waits is an alert; a direct input waiting more
# blocks than this for a covering frame is an alert (the scheduler forces it at 1200)
QA_TRAFFIC_SEQ_LANDING_DEADLINE_MINUTES=240
QA_TRAFFIC_SEQ_BATCH_SILENCE_MINUTES=180
QA_TRAFFIC_SEQ_DIRECT_WAIT_ALERT_BLOCKS=600
# users stop using the sequencer while its per-op fee is above this (TestUsdc)
QA_TRAFFIC_MAX_OP_FEE_USDC=0.5

# ---- vouchers ---------------------------------------------------------------------------------
QA_TRAFFIC_EXEC_DEADLINE_HOURS=24
QA_TRAFFIC_VOUCHER_OVERDUE_GRACE_MINUTES=60
# Estimated time from an epoch closing to its vouchers becoming executable, used ONLY on PRT
# (Dave) apps, where the consensus contract exposes no claim-staging period to read on-chain.
# It drives the "voucher not executable past its estimate" warning: too low and the warning
# fires through every normal settlement; set it near the app's observed claim+dispute window
# (measured ~18-19 h on this deployment). Ignored on Authority/Quorum (the staging period is
# read from the chain there).
QA_TRAFFIC_PRT_SETTLE_HOURS=20
QA_TRAFFIC_FINALITY_LAG_BLOCKS=96
QA_TRAFFIC_BLOCK_TIME_SECONDS=12

# ---- fees and gas (ETH / gwei) ----------------------------------------------------------------
QA_TRAFFIC_MAX_FEE_GWEI=30
QA_TRAFFIC_TIP_MIN_GWEI=0.001
QA_TRAFFIC_TIP_MAX_GWEI=0.05
QA_TRAFFIC_GAS_MIN_ETH=0.0005
QA_TRAFFIC_GAS_TOPUP_MIN_ETH=0.001
QA_TRAFFIC_GAS_TOPUP_MAX_ETH=0.004
QA_TRAFFIC_DAILY_GAS_BUDGET_ETH=0.05
QA_TRAFFIC_FUNDER_MIN_ETH=0.05
QA_TRAFFIC_FUNDER_DROP_ALERT_ETH=0.05
QA_TRAFFIC_RUNWAY_ALERT_DAYS=5

# ---- Discord ----------------------------------------------------------------------------------
# Reuse another service's env file (e.g. the Starknet monitor's config.env): only
# DISCORD_WEBHOOK_URL is read from that file. Absolute path.
QA_TRAFFIC_DISCORD_ENV_FILE=
# or set a webhook directly (wins over the file). SECRET -- on fly.io use `fly secrets set`.
# (The ENV_FILE indirection does not work on fly.io; set the webhook here/as a secret instead.)
QA_TRAFFIC_DISCORD_WEBHOOK_URL=
# Master switch: false disables all Discord delivery regardless of the webhook above (default true).
QA_TRAFFIC_DISCORD_ENABLED=true
QA_TRAFFIC_DISCORD_PREFIX=[cartesi-traffic]
QA_TRAFFIC_REPORT_TIME=23:55
QA_TRAFFIC_REPORT_TZ=Africa/Lagos
QA_TRAFFIC_ALERT_REPEAT_HOURS=6
# optional external dead-man's switch (e.g. a healthchecks.io ping URL); off when empty
QA_TRAFFIC_HEALTHCHECK_URL=

# ---- liveness endpoint (for fly.io / container health checks) ---------------------------------
# A tiny HTTP server that returns 200 while the loop is making progress and 503 once it has been
# stuck for longer than MAX_STALE (the loop swallows errors and never exits, so process-liveness
# alone cannot catch a wedge). 0 = off (the systemd deployment relies on the Type=notify watchdog
# instead). On fly.io set a port (e.g. 8080) and point fly.toml [[checks]] at it so a frozen
# Machine is restarted. Any GET path works; the body is JSON with last_ok_age_s.
QA_TRAFFIC_HEALTH_PORT=0
QA_TRAFFIC_HEALTH_MAX_STALE_SECONDS=600

# ---- cadence (seconds) ------------------------------------------------------------------------
QA_TRAFFIC_LOOP_SECONDS=10
QA_TRAFFIC_RECONCILE_SECONDS=75
QA_TRAFFIC_CHECKS_SECONDS=600
QA_TRAFFIC_BALANCE_SAMPLE=12
QA_TRAFFIC_NODE_INPUT_LAG_ALERT_MINUTES=45
QA_TRAFFIC_RPC_FAILURES_BEFORE_ALERT=5

# ---- logging ----
# JSON event lines go to logs/events-YYYY-MM-DD.jsonl (0600, one file per UTC day) and a
# human line to stdout (journald/fly logs). Secrets are scrubbed. Level: debug|info|warn|error.
QA_TRAFFIC_LOG_LEVEL=info
# delete event files older than this many days (bounds disk on a persistent host/volume)
QA_TRAFFIC_LOG_RETENTION_DAYS=14
